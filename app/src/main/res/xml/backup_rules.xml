<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup deshabilitado (Android 11 o anterior): la app guarda tokens, hash del PIN,
   secreto TOTP e identidad del dispositivo. Nada debe salir del dispositivo.
   Ver https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
